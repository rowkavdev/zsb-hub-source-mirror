    "restart": {
      "type": "boolean",
      "label": "Redeem full passes (also while farming is off)",
      "default": true
    },
    "farm_blackjack": {
      "type": "boolean",
      "label": "Blackjack",
      "help": "10 XP a hand.",
      "default": true
