{
  "id": "skillmaps",
  "name": "Skillmaps",
  "version": "3.1.0",
  "description": "A tool for setting up accounts' skills: pick the accounts and a preset, then Apply. Each skill costs its price plus a skill point (3 a rank, 54 by Global Elite).",
  "minCore": "1.2.14",
  "main": "index.js",
  "tab": "Skillmaps",
  "group": "management",
  "defaultEnabled": false,
  "settings": {
    "accounts": {
      "type": "accounts",
      "label": "Accounts"
    },
    "plan": {
      "type": "choice",
      "label": "Preset",
      "default": "ge16",
      "options": [
        {
          "value": "opens35",
          "label": "35 opens ×2, money per click"
        },
        {
          "value": "opens31",
          "label": "31 opens ×2, money per click"
        },
        {
          "value": "opens19",
          "label": "19 opens ×2, 33.5% cases"
        },
        {
          "value": "ge16",
          "label": "16 opens, 33.6% cases"
        }
      ],
      "hidden": true
    },
    "sellOthers": {
      "type": "boolean",
      "label": "Sell skills outside the preset first (for half their price)",
      "default": false
    }
  }
}
