{
  "id": "trader",
  "name": "Trader",
  "version": "1.13.0",
  "description": "Moves tokens and items between your accounts: one trade at a time, or by trade routes you set up (from which accounts, to which account, and what goes: tokens, terminals, skins over a price or by name). Both sides must be accounts in this app and clicking. Starts in practice mode.",
  "minCore": "1.2.14",
  "main": "index.js",
  "tab": "Trader",
  "group": "trading",
  "defaultEnabled": false,
  "settings": {
    "routes": {
      "type": "list",
      "label": "Trade routes",
      "itemLabel": "route",
      "fields": {
        "to": {
          "type": "account",
          "label": "Send to",
          "help": "The account that receives everything on this route."
        },
        "from": {
          "type": "accounts",
          "label": "From these accounts",
          "exclude": "to",
          "when": "to",
          "detail": "tokens"
        },
        "h1": {
          "type": "heading",
          "label": "What to send",
          "help": "Switch on what this route moves. Each trade takes as many items as the sender may trade at once (50, or 200 for Pro).",
          "when": "to"
        },
        "tokens": {
          "type": "boolean",
          "label": "Tokens (Pro senders only)",
          "default": false,
          "when": "to"
        },
        "keepTokens": {
          "type": "number",
          "label": "Keep on each sender",
          "default": 0,
          "when": "tokens"
        },
        "minTokens": {
          "type": "number",
          "label": "Only send when there are at least",
          "default": 1000000,
          "when": "tokens"
        },
        "terminals": {
          "type": "choice",
          "label": "Terminals",
          "default": "none",
          "when": "to",
          "options": [
            {
              "value": "none",
              "label": "Don't send"
            },
            {
              "value": "all",
              "label": "All terminals"
            },
            {
              "value": "genesis",
              "label": "Genesis only"
            },
            {
              "value": "deadhand",
              "label": "Dead Hand only"
            }
          ],
          "newline": true
        },
        "skins": {
          "type": "boolean",
          "label": "Skins",
          "default": false,
          "when": "to"
        },
        "skinsOver": {
          "type": "number",
          "label": "Worth at least ($, 0 = by name only)",
          "default": 0,
          "when": "skins"
        },
        "names": {
          "type": "text",
          "label": "Or named (comma-separated)",
          "default": "",
          "placeholder": "e.g. Dragon Lore, Howl",
          "when": "skins"
        },
        "filt": {
          "type": "boolean",
          "label": "Items matching inventory filters",
          "default": false,
          "when": "to",
          "newline": true,
          "help": "The game's inventory filters, as on View inventory: e.g. Patterns: Only sends every pattern item."
        },
        "fSearch": {
          "type": "text",
          "label": "Search",
          "default": "",
          "placeholder": "any name",
          "when": "filt"
        },
        "fPatterns": {
          "type": "choice",
          "label": "Patterns",
          "default": "",
          "when": "filt",
          "options": [
            {
              "value": "",
              "label": "Any"
            },
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "only",
              "label": "Only"
            }
          ]
        },
        "fRarity": {
          "type": "choice",
          "label": "Rarity",
          "default": "",
          "when": "filt",
          "options": [
            {
              "value": "",
              "label": "Any"
            },
            {
              "value": "Consumer Grade",
              "label": "Consumer Grade"
            },
            {
              "value": "Industrial Grade",
              "label": "Industrial Grade"
            },
            {
              "value": "Mil-Spec Grade",
              "label": "Mil-Spec Grade"
            },
            {
              "value": "Restricted",
              "label": "Restricted"
            },
            {
              "value": "Classified",
              "label": "Classified"
            },
            {
              "value": "Covert",
              "label": "Covert"
            }
          ]
        },
        "fExterior": {
          "type": "choice",
          "label": "Exterior",
          "default": "",
          "when": "filt",
          "options": [
            {
              "value": "",
              "label": "Any"
            },
            {
              "value": "Factory New",
              "label": "Factory New"
            },
            {
              "value": "Minimal Wear",
              "label": "Minimal Wear"
            },
            {
              "value": "Field-Tested",
              "label": "Field-Tested"
            },
            {
              "value": "Well-Worn",
              "label": "Well-Worn"
            },
            {
              "value": "Battle-Scarred",
              "label": "Battle-Scarred"
            }
          ]
        },
        "fStSv": {
          "type": "choice",
          "label": "StatTrak/Souvenir",
          "default": "",
          "when": "filt",
          "options": [
            {
              "value": "",
              "label": "Any"
            },
            {
              "value": "None",
              "label": "None"
            },
            {
              "value": "Non ST",
              "label": "Non ST"
            },
            {
              "value": "Non SV",
              "label": "Non SV"
            },
            {
              "value": "Only ST",
              "label": "Only ST"
            },
            {
              "value": "Only SV",
              "label": "Only SV"
            }
          ]
        },
        "fQuality": {
          "type": "choice",
          "label": "Quality",
          "default": "",
          "when": "filt",
          "options": [
            {
              "value": "",
              "label": "Any"
            },
            {
              "value": "0",
              "label": "Common"
            },
            {
              "value": "1",
              "label": "Rare"
            },
            {
              "value": "2",
              "label": "Epic"
            },
            {
              "value": "3",
              "label": "Legendary"
            }
          ]
        },
        "fFloatRank": {
          "type": "choice",
          "label": "Float Rank",
          "default": "",
          "when": "filt",
          "options": [
            {
              "value": "",
              "label": "Any"
            },
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "all",
              "label": "Only"
            }
          ]
        },
        "fEvent": {
          "type": "choice",
          "label": "Event",
          "default": "",
          "when": "filt",
          "options": [
            {
              "value": "",
              "label": "Any"
            },
            {
              "value": "None",
              "label": "None"
            },
            {
              "value": "All",
              "label": "Only"
            }
          ]
        },
        "skipFavorites": {
          "type": "boolean",
          "label": "Keep favourited items (skins and terminals)",
          "default": true,
          "when": "to"
        },
        "h2": {
          "type": "heading",
          "label": "Only trade when",
          "when": "to"
        },
        "minItems": {
          "type": "number",
          "label": "There are at least this many items",
          "default": 1,
          "when": "to",
          "help": "Saves the receiver's 100 trades a day for full trades."
        }
      }
    },
    "oneItem": {
      "type": "tags",
      "label": "Items (none = tokens only)",
      "default": [],
      "placeholder": "e.g. Dragon Lore, then Enter",
      "page": true
    },
    "oneTo": {
      "type": "account",
      "label": "Send to",
      "page": true
    },
    "oneCount": {
      "type": "text",
      "label": "How many of each, per sender (empty = all)",
      "default": "",
      "placeholder": "all",
      "page": true
    },
    "oneFilt": {
      "type": "boolean",
      "label": "Send by inventory filters",
      "default": false,
      "hidden": true,
      "page": true
    },
    "oneFavs": {
      "type": "boolean",
      "label": "Include favourited items",
      "default": false,
      "page": true
    },
    "oneTokens": {
      "type": "text",
      "label": "Tokens per sender (Pro only)",
      "default": "",
      "placeholder": "none — or 500K, 2.5M, all",
      "page": true
    },
    "oneFrom": {
      "type": "accounts",
      "hidden": true
    },
    "invSearch": {
      "type": "text",
      "label": "Search this inventory",
      "default": "",
      "placeholder": "e.g. Dragon Lore, AK-47",
      "page": true
    },
    "invSort": {
      "type": "choice",
      "label": "Sort",
